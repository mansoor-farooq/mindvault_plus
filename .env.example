# ==============================================================================
# MINDVAULT PLUS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# --- Application & Server Settings ---
PORT=3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# --- PostgreSQL Database Configuration ---
# Standard connection string format: postgres://<user>:<password>@<host>:<port>/<db_name>
DB_NAME=mindvault
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://postgres:your_database_password_here@localhost:5432/mindvault

# --- Authentication & Cryptographic Secrets ---
# User-facing JWT Secret for staff & business authentication (minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_32_characters_here

# Admin Panel Session Secret (signs httpOnly session cookies)
ADMIN_JWT_SECRET=your_admin_jwt_secret_min_32_characters_here

# HMAC secret for ad-unlock nonces and Google OAuth state verification
AD_SECRET=your_ad_secret_key_here

# --- Google Gemini AI Engine ---
# Primary Gemini API Key (Generate at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000

# Multi-Key Gemini Rotation (Comma-separated for automated quota load-balancing)
GEMINI_API_KEYS=your_first_gemini_key_here,your_second_gemini_key_here

# --- Google OAuth 2.0 (Drive Backup & Google Sign-In) ---
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/drive/callback
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- SMTP Email Transport (Quotations, Contact Us, System Alerts) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email_address@gmail.com
SMTP_PASS=your_gmail_app_password
CONTACT_RECEIVER_EMAIL=your_support_or_admin_email@gmail.com
